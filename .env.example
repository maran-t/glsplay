# ---------------------------------------------------------------------------
# glsplay - copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Signaling broker
GLSPLAY_SIGNALING_PORT=8080
GLSPLAY_SIGNALING_HOST=0.0.0.0

# Shared secret presented by BOTH the host daemon and the browser client.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GLSPLAY_ROOM_SECRET=change-me-before-exposing-this-to-the-internet

# Browser client (NEXT_PUBLIC_ vars are inlined into the bundle - no secrets here
# except the room secret, which is unavoidable for a POC with no user accounts)
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080
NEXT_PUBLIC_ROOM_ID=poc
NEXT_PUBLIC_ROOM_SECRET=change-me-before-exposing-this-to-the-internet

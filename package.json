{
  "name": "glsplay",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Browser-based cloud gaming - GCP L4 to Chrome over WebRTC, sub-45ms glass-to-glass",
  "workspaces": [
    "packages/protocol",
    "apps/signaling",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @glsplay/protocol && npm run build -w @glsplay/signaling && npm run build -w @glsplay/web",
    "dev": "concurrently -n signal,web -c cyan,magenta \"npm:dev:signaling\" \"npm:dev:web\"",
    "dev:signaling": "npm run dev -w @glsplay/signaling",
    "dev:web": "npm run dev -w @glsplay/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rimraf \"packages/*/dist\" \"apps/signaling/dist\" \"apps/web/.next\" apps/host/build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20.11.0" }
}
